# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB (docker compose up -d) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/amazon-clone

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters in production.
JWT_SECRET=
# Cookie SameSite policy: "lax" (default; same-site deploys / Vercel proxy) or "none" (cross-site API, requires HTTPS)
COOKIE_SAMESITE=lax

# ---- CORS ----
# Comma-separated list of allowed frontend origins; the first one is used for Stripe redirects
CLIENT_URL=http://localhost:5173

# ---- Stripe (TEST mode only; leave empty to use Cash on Delivery only) ----
# Get a test key at https://dashboard.stripe.com/test/apikeys  (starts with sk_test_)
STRIPE_SECRET_KEY=

# ---- Optional: used only by `npm run seed` to create the first admin account ----
# Choose your own values; never commit them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
